# ── 학습 산출물 ──────────────────────────────────────────────
runs/
*.pt
# 루트의 사전학습·벤치마크 임시 .onnx
/*.onnx

# ── 데이터셋 — 현장 사진·라벨은 절대 커밋하지 않는다 ─────────
# prepare_dataset.py 가 data/train, data/valid 를 만든다 (2026-08-28 실배치).
data/*
!data/.gitkeep
!data/dataset.yaml.example

# ── 모델 ────────────────────────────────────────────────────
# 학습된 가중치는 git 에 넣지 않는다 — 재학습마다 수십 MB 가 쌓인다.
# 웹 배포는 로컬의 web/models/best.onnx 를 그대로 올린다 (README 참조).
models/*
!models/.gitkeep
web/models/

# ── 웹 임시 파일 ────────────────────────────────────────────
web/__test.jpg

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
